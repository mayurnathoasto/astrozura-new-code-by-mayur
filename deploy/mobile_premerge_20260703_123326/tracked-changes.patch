-class _NorthIndianChart extends StatelessWidget {
-  const _NorthIndianChart();
-
-  // House placements: house -> content string
-  static const Map<int, String> _houseData = {
-    1:  'Virgo\nMars\nRahu',
-    2:  'Libra',
-    3:  'Scorpio\nMoon',
-    4:  'Sagittarius\nVenus',
-    5:  'Capricorn\nSun\nMerc\nJup',
-    6:  'Aquarius',
-    7:  'Pisces\nSat\nKetu',
-    8:  'Aries',
-    9:  'Taurus',
-    10: 'Gemini',
-    11: 'Cancer',
-    12: 'Leo',
-  };
-
-  @override
-  Widget build(BuildContext context) {
-    final size = MediaQuery.of(context).size.width - 64;
-    final s = size.clamp(240.0, 320.0);
-    return CustomPaint(
-      size: Size(s, s),
-      painter: _NorthIndianChartPainter(_houseData),
-    );
-  }
-}
-
-class _NorthIndianChartPainter extends CustomPainter {
-  final Map<int, String> houseData;
-  _NorthIndianChartPainter(this.houseData);
-
-  @override
-  void paint(Canvas canvas, Size size) {
-    final w = size.width;
-    final h = size.height;
-    final cx = w / 2;
-    final cy = h / 2;
-
-    final borderPaint = Paint()
-      ..color = const Color(0xFF1B3A6B)
-      ..style = PaintingStyle.stroke
-      ..strokeWidth = 1.5;
-
-    final fillPaint = Paint()..style = PaintingStyle.fill;
-
-    // Outer square
-    canvas.drawRect(Rect.fromLTWH(0, 0, w, h), borderPaint);
-
-    // Inner diamond (diagonals)
-    final path = Path()
-      ..moveTo(cx, 0)
-      ..lineTo(w, cy)
-      ..lineTo(cx, h)
-      ..lineTo(0, cy)
-      ..close();
-    canvas.drawPath(path, borderPaint);
-
-    // Quadrant lines
-    canvas.drawLine(Offset(0, 0), Offset(cx, cy), borderPaint);
-    canvas.drawLine(Offset(w, 0), Offset(cx, cy), borderPaint);
-    canvas.drawLine(Offset(w, h), Offset(cx, cy), borderPaint);
-    canvas.drawLine(Offset(0, h), Offset(cx, cy), borderPaint);
-
-    // Fill lagna (house 1 = top diamond)
-    final lagnaPath = Path()
-      ..moveTo(cx, 0)
-      ..lineTo(w / 2 + w / 4, h / 4)
-      ..lineTo(cx, cy)
-      ..lineTo(w / 4, h / 4)
-      ..close();
-    fillPaint.color = const Color(0xFFEDE9FE);
-    canvas.drawPath(lagnaPath, fillPaint);
-    canvas.drawPath(lagnaPath, borderPaint);
-
-    // House text positions (approximate centers)
-    final centers = <int, Offset>{
-      1:  Offset(cx, h * 0.16),
-      2:  Offset(w * 0.84, h * 0.16),
-      3:  Offset(w * 0.84, cy),
-      4:  Offset(w * 0.84, h * 0.84),
-      5:  Offset(cx, h * 0.84),
-      6:  Offset(w * 0.16, h * 0.84),
-      7:  Offset(w * 0.16, cy),
-      8:  Offset(w * 0.16, h * 0.16),
-      9:  Offset(w * 0.25, h * 0.25),
-      10: Offset(w * 0.75, h * 0.25),
-      11: Offset(w * 0.75, h * 0.75),
-      12: Offset(w * 0.25, h * 0.75),
-    };
-
-    final tp = TextPainter(textDirection: TextDirection.ltr);
-    for (final entry in centers.entries) {
-      final text = houseData[entry.key] ?? '';
-      tp.text = TextSpan(
-        text: text,
-        style: TextStyle(
-          fontSize: entry.key == 1 ? 9.5 : 8.5,
-          fontWeight: entry.key == 1 ? FontWeight.w700 : FontWeight.w500,
-          color: entry.key == 1 ? const Color(0xFF5B2D8E) : const Color(0xFF1A1A1A),
-          height: 1.4,
-        ),
-      );
-      tp.layout(maxWidth: w * 0.22);
-      tp.paint(
-        canvas,
-        Offset(entry.value.dx - tp.width / 2, entry.value.dy - tp.height / 2),
-      );
-    }
-  }
-
-  @override
-  bool shouldRepaint(_) => false;
-}
