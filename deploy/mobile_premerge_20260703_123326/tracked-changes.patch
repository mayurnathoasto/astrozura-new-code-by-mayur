-class _NorthChartPainter extends CustomPainter {
-  final Map<int, String> houseData;
-  _NorthChartPainter(this.houseData);
-
-  @override
-  void paint(Canvas canvas, Size size) {
-    final w = size.width;
-    final h = size.height;
-    final cx = w / 2;
-    final cy = h / 2;
-
-    final stroke = Paint()
-      ..color = const Color(0xFF1E3557)
-      ..style = PaintingStyle.stroke
-      ..strokeWidth = 1.2;
-
-    final lagnaFill = Paint()
-      ..color = const Color(0xFFFFF8DF)
-      ..style = PaintingStyle.fill;
-
-    // Outer
-    canvas.drawRect(Rect.fromLTWH(0, 0, w, h), stroke);
-
-    // Inner diamond
-    final diamond = Path()
-      ..moveTo(cx, 0)
-      ..lineTo(w, cy)
-      ..lineTo(cx, h)
-      ..lineTo(0, cy)
-      ..close();
-
-    // Lagna fill (top triangle)
-    final lagnaPath = Path()
-      ..moveTo(cx, 0)
-      ..lineTo(w * 0.75, h * 0.25)
-      ..lineTo(cx, cy)
-      ..lineTo(w * 0.25, h * 0.25)
-      ..close();
-    canvas.drawPath(lagnaPath, lagnaFill);
-    canvas.drawPath(lagnaPath, stroke);
-
-    canvas.drawPath(diamond, stroke);
-
-    // Corner lines
-    canvas.drawLine(Offset(0, 0),   Offset(cx, cy), stroke);
-    canvas.drawLine(Offset(w, 0),   Offset(cx, cy), stroke);
-    canvas.drawLine(Offset(w, h),   Offset(cx, cy), stroke);
-    canvas.drawLine(Offset(0, h),   Offset(cx, cy), stroke);
-
-    // Text positions
-    final centers = <int, Offset>{
-      1: Offset(cx, h * 0.15),
-      2: Offset(w * 0.85, h * 0.15),
-      3: Offset(w * 0.85, cy),
-      4: Offset(w * 0.85, h * 0.85),
-      5: Offset(cx, h * 0.85),
-      6: Offset(w * 0.15, h * 0.85),
-      7: Offset(w * 0.15, cy),
-      8: Offset(w * 0.15, h * 0.15),
-      9: Offset(w * 0.24, h * 0.24),
-      10: Offset(w * 0.76, h * 0.24),
-      11: Offset(w * 0.76, h * 0.76),
-      12: Offset(w * 0.24, h * 0.76),
-    };
-
-    final tp = TextPainter(textDirection: TextDirection.ltr);
-    for (final entry in centers.entries) {
-      final text = houseData[entry.key] ?? '';
-      tp.text = TextSpan(
-        text: text,
-        style: TextStyle(
-          fontSize: entry.key == 1 ? 7.5 : 7,
-          fontWeight: entry.key == 1 ? FontWeight.w700 : FontWeight.w500,
-          color: entry.key == 1
-              ? const Color(0xFF1E3557)
-              : const Color(0xFF374151),
-          height: 1.3,
-        ),
-      );
-      tp.layout(maxWidth: w * 0.22);
-      tp.paint(canvas,
-          Offset(entry.value.dx - tp.width / 2,
-              entry.value.dy - tp.height / 2));
-    }
-  }
-
-  @override
-  bool shouldRepaint(_) => false;
-}
